# Copy to .env (git-ignored) and fill in. Never commit real values.
DB_PASSWORD=change-me
# 32+ characters, e.g. generate with: openssl rand -base64 48
JWT_SECRET=
# Creates the first ADMIN when the users table is empty (password: 8-72 chars, upper, lower, digit, one of @$!%*?&)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
# Set to false in production to hide Swagger
DOCS_ENABLED=true
