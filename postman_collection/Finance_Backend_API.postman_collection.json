{
  "info": {
    "name": "Finance Ledger API",
    "description": "Set adminEmail/adminPassword (the bootstrap admin), run Login first; it stores the token in the collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseURL",
      "value": "http://localhost:8080"
    },
    {
      "key": "adminEmail",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "recordId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseURL}}/api/auth/login",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login ok', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "User Management (Admin)",
      "item": [
        {
          "name": "Create user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseURL}}/api/users",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "api",
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana Analyst\",\n  \"email\": \"analyst@example.com\",\n  \"password\": \"Passw0rd@1\",\n  \"role\": \"ANALYST\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.collectionVariables.set('userId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseURL}}/api/users?page=0&size=20",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "api",
                "users"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "Get user",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseURL}}/api/users/{{userId}}",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "api",
                "users",
                "{{userId}}"
              ]
            }
          }
        },
        {
          "name": "Deactivate user",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseURL}}/api/users/{{userId}}/deactivate",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "api",
                "users",
                "{{userId}}",
                "deactivate"
              ]
            }
          }
        },
        {
          "name": "Activate user",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseURL}}/api/users/{{userId}}/activate",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "api",
                "users",
                "{{userId}}",
                "activate"
              ]
            }
          }
        },
        {
          "name": "Delete user",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseURL}}/api/users/{{userId}}",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "api",
                "users",
                "{{userId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Financial Records",
      "item": [
        {
          "name": "Create record (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseURL}}/api/records",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "api",
                "records"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 1200.5,\n  \"type\": \"INCOME\",\n  \"category\": \"Salary\",\n  \"date\": \"2026-04-01\",\n  \"description\": \"April salary\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.collectionVariables.set('recordId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List records",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseURL}}/api/records?page=0&size=10",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "api",
                "records"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "List records (filtered)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseURL}}/api/records?type=EXPENSE&category=Food&from=2026-04-01&to=2026-04-30",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "api",
                "records"
              ],
              "query": [
                {
                  "key": "type",
                  "value": "EXPENSE"
                },
                {
                  "key": "category",
                  "value": "Food"
                },
                {
                  "key": "from",
                  "value": "2026-04-01"
                },
                {
                  "key": "to",
                  "value": "2026-04-30"
                }
              ]
            }
          }
        },
        {
          "name": "Get record",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseURL}}/api/records/{{recordId}}",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "api",
                "records",
                "{{recordId}}"
              ]
            }
          }
        },
        {
          "name": "Update record (Admin)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseURL}}/api/records/{{recordId}}",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "api",
                "records",
                "{{recordId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 1300.0,\n  \"type\": \"INCOME\",\n  \"category\": \"Salary\",\n  \"date\": \"2026-04-01\"\n}"
            }
          }
        },
        {
          "name": "Delete record (Admin, soft)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseURL}}/api/records/{{recordId}}",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "api",
                "records",
                "{{recordId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseURL}}/api/dashboard/summary",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "api",
                "dashboard",
                "summary"
              ]
            }
          }
        },
        {
          "name": "Summary (date range)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseURL}}/api/dashboard/summary?from=2026-04-01&to=2026-04-30",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "api",
                "dashboard",
                "summary"
              ],
              "query": [
                {
                  "key": "from",
                  "value": "2026-04-01"
                },
                {
                  "key": "to",
                  "value": "2026-04-30"
                }
              ]
            }
          }
        },
        {
          "name": "Monthly trends",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseURL}}/api/dashboard/trends?months=12",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "api",
                "dashboard",
                "trends"
              ],
              "query": [
                {
                  "key": "months",
                  "value": "12"
                }
              ]
            }
          }
        },
        {
          "name": "Anomaly insights (Admin, Analyst)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseURL}}/api/dashboard/insights?months=12",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "api",
                "dashboard",
                "insights"
              ],
              "query": [
                {
                  "key": "months",
                  "value": "12"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Audit Ledger (Admin, Analyst)",
      "item": [
        {
          "name": "List audit entries",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseURL}}/api/audit?page=0&size=20",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "api",
                "audit"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "Verify ledger",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseURL}}/api/audit/verify",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "api",
                "audit",
                "verify"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ledger valid', () => pm.expect(pm.response.json().valid).to.be.true);"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}